# Supabase PostgreSQL Session Pooler URL (port 5432).
# URL-encode special characters in the password; keep the URL secret.
# SSL is required automatically if sslmode is omitted.
DATABASE_URL=<SUPABASE_POSTGRES_CONNECTION_STRING>
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30
QUIZ_DURATION_MINUTES=20
QUIZ_QUESTION_COUNT=15
REFRESH_COOKIE_NAME=smart_school_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/v1/auth
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
